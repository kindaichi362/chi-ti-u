<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera and Audio permissions for QR Pay and Voice Transaction Tracking -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Queries for Vietnamese Banking apps and Speech Recognition Service -->
    <queries>
        <!-- Speech Recognition Service for Vietnamese Voice Input on Android 11+ -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>

        <!-- Popular Vietnamese Banks -->
        <package android:name="com.VCB" /> <!-- Vietcombank -->
        <package android:name="vn.com.techcombank.bb.app" /> <!-- Techcombank -->
        <package android:name="com.mbmobile" /> <!-- MBBank -->
        <package android:name="com.vnpay.vpbankonline" /> <!-- VPBank NEO -->
        <package android:name="com.vnpay.bidv" /> <!-- BIDV SmartBanking -->
        <package android:name="com.vietinbank.ipay" /> <!-- VietinBank iPay -->
        <package android:name="mobile.acb.com.vn" /> <!-- ACB ONE -->
        <package android:name="com.tpb.mb.gprsandroid" /> <!-- TPBank Mobile -->
        <package android:name="com.mservice.momotransfer" /> <!-- MoMo -->
        <package android:name="vn.com.vng.zalopay" /> <!-- ZaloPay -->
        <package android:name="vn.com.vpbank.cake" /> <!-- Cake by VPBank -->
        <package android:name="com.vnpay.ocb" /> <!-- OCB OMNI -->
        <package android:name="com.vnpay.msacombank" /> <!-- Sacombank -->
        <package android:name="com.vnpay.hdbank" /> <!-- HDBank -->
        <package android:name="com.vn.vib.mobileapp" /> <!-- MyVIB -->

        <!-- Common URL Schemes -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vietcombank" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="vcbdigibank" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mbbank" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tcb" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tpbank" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="momo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="zalopay" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
